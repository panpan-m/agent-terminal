<service>
  <!-- WinSW configuration for tio-server (https://github.com/winsw/winsw).
       Copy next to WinSW.exe as tio-server.xml and install with:
         WinSW.exe install
         WinSW.exe start
  -->
  <id>tio-server</id>
  <name>tio-server serial gateway</name>
  <description>Single-owner serial port gateway with MCP and web UI</description>

  <executable>C:\Program Files\tio-server\tio-server.exe</executable>
  <arguments>run --config "C:\ProgramData\tio-server\config.toml"</arguments>
  <workingdirectory>C:\ProgramData\tio-server</workingdirectory>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 day</resetfailure>

  <logpath>C:\ProgramData\tio-server\logs\service</logpath>
  <logmode>rotate</logmode>
  <logfile>tio-server.out.log</logfile>
  <logfile>tio-server.err.log</logfile>

  <env name="TIO_SERVER_HOME" value="C:\ProgramData\tio-server" />

  <stopParentFirst>false</stopParentFirst>
  <killTimeout>15 sec</killTimeout>
</service>
