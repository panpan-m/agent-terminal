[Unit]
Description=agent-terminal terminal gateway
Documentation=file:///usr/share/doc/agent-terminal/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tio
Group=dialout
StateDirectory=agent-terminal
LogsDirectory=agent-terminal
# Runtime config is writable by the service; /etc holds only the seed file.
ExecStart=/opt/agent-terminal/agent-terminal run --config /var/lib/agent-terminal/config.toml
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-terminal /var/log/agent-terminal
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
